      {
        "hooks": [
          {
            "additionalContextLimit": 6000,
            "command": "CA_MANAGED_HOOK=compound-agent-v1 '/mnt/c/Users/ROG/AppData/Roaming/npm/ca' prime 2\u003e/dev/null || true",
            "commandWindows": "$env:CA_MANAGED_HOOK='compound-agent-v1'; \u0026 'C:\\Users\\ROG\\AppData\\Roaming\\npm\\ca.exe' prime 2\u003e$null; exit 0",
